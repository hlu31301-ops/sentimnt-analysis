# ==========================================
# [MoodLens 환경 변수 설정 템플릿]
# ==========================================
# 이 파일은 환경 변수 예시 파일입니다.
# 실제 키 값은 .env 파일에 입력해주세요.

# 서버 포트 번호 (기본값: 3000)
PORT=3000

# 1. OpenAI API 설정
# OpenAI 대시보드(https://platform.openai.com/api-keys)에서 발급받은 Secret API Key를 입력하세요.
OPENAI_API_KEY=your_openai_api_key_here

# 2. Supabase 데이터베이스 설정
# Supabase 프로젝트 대시보드 -> Project Settings -> API 메뉴에서 확인 가능합니다.
# Project URL (예: https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Project API Keys - anon / public 키 (브라우저 또는 서버에서 접근 가능한 기본 클라이언트 키)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Project API Keys - service_role / secret 키 (서버 전용 관리자 권한 키 - 절대 외부에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

